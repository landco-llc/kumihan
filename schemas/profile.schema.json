{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumihan:schema:profile:0.1.0",
  "title": "KUMIHAN media profile",
  "description": "A media-specific selection of catalog rules and guidance. Rule references must resolve in the complete catalog.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:kumihan:schema:rule:0.1.0#/$defs/media_profile"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:kumihan:schema:rule:0.1.0#/$defs/rule_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "revision",
    "title",
    "description",
    "rule_ids",
    "guidance"
  ],
  "additionalProperties": false
}
