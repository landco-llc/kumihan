{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumihan:schema:release-manifest:0.1.0",
  "title": "KUMIHAN release manifest",
  "description": "Public product metadata for an exact source and artifact set. Independent review references require verification. Publication approval is separate and must bind the exact source commit, tree and artifact digests.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "not": {
              "pattern": "\\s"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "minLength": 71,
            "maxLength": 71
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "digest",
          "size"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "build_environment": {
      "type": "object",
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "builder_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "not": {
            "pattern": "\\s"
          }
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "python_version",
        "platform",
        "builder_version",
        "source_epoch",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "included_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "kumihan",
          "kumihan-web",
          "kumihan-documents",
          "kumihan-review"
        ]
      },
      "minItems": 4,
      "uniqueItems": true,
      "maxItems": 4
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "ruleset_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "check_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "independent_review_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "source_commit",
    "source_tree",
    "artifacts",
    "build_environment",
    "included_skills",
    "schema_version",
    "ruleset_version",
    "check_refs",
    "independent_review_ref",
    "known_limitations"
  ],
  "additionalProperties": false
}
