{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landco-llc.github.io/kumihan/schemas/ziheng-v1/report.schema.json",
  "title": "KUMIHAN evidence-based report",
  "description": "A report about one exact artifact. Evidence relevance, check-key uniqueness, waiver freshness and method truthfulness require semantic validation; a schema-valid report is not proof of a pass.",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "ruleset_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "profile": {
      "$ref": "rule.schema.json#/$defs/media_profile"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "host",
        "tools",
        "renderers"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "content_change_summary": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "locale": {
      "enum": [
        "zh-Hant-TW",
        "zh-Hant-HK"
      ]
    }
  },
  "required": [
    "report_id",
    "artifact_ref",
    "artifact_digest",
    "ruleset_version",
    "profile",
    "checks",
    "environment",
    "limitations",
    "content_change_summary",
    "locale"
  ],
  "additionalProperties": false,
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "needs-review",
        "not-checked",
        "unsupported",
        "waived",
        "not-applicable"
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "rule_id": {
          "$ref": "rule.schema.json#/$defs/rule_id"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "method": {
          "$ref": "rule.schema.json#/$defs/method"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "waiver": {
          "type": "object",
          "properties": {
            "approval_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "artifact_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "minLength": 71,
              "maxLength": 71
            }
          },
          "required": [
            "approval_ref",
            "scope",
            "reason",
            "artifact_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rule_id",
        "status",
        "method",
        "evidence_refs",
        "scope",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "waived"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "waiver"
            ]
          },
          "else": {
            "not": {
              "required": [
                "waiver"
              ]
            }
          }
        }
      ]
    }
  }
}
