{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ziheng 0.2.2 original vertical fixture templates",
  "description": "Expected conditions are not execution results. scripts/checks.py checks exact text hashes, annotation spans and unique fixture IDs. Keep all execution observations in separate evidence sidecars.",
  "type": "object",
  "required": [
    "schema_version",
    "counts",
    "fixtures",
    "current_execution_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.2"
    },
    "counts": {
      "const": {
        "TW": 12,
        "HK": 10,
        "shared": 8,
        "total": 30
      }
    },
    "current_execution_status": {
      "const": "not-checked"
    },
    "fixtures": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "text",
          "text_encoding",
          "text_code_point_count",
          "text_utf8_sha256",
          "annotations",
          "source_refs",
          "candidate_ids",
          "review_context",
          "source_policy",
          "expected",
          "execution_status_by_method",
          "status",
          "result",
          "execution_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^V-(TW|HK|SH)[0-9]{2}$"
          },
          "group": {
            "enum": [
              "TW",
              "HK",
              "shared"
            ]
          },
          "text": {
            "type": "string"
          },
          "text_encoding": {
            "const": "UTF-8"
          },
          "text_code_point_count": {
            "type": "integer",
            "minimum": 0
          },
          "text_utf8_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "text",
                "start_code_point",
                "end_code_point_exclusive"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start_code_point": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_code_point_exclusive": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": true
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ZV-[SFDR][0-9]{2}$"
            },
            "uniqueItems": true
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^V-[ABC][0-9]{2}$"
            },
            "uniqueItems": true
          },
          "review_context": {
            "$ref": "review-context-v2.schema.json"
          },
          "source_policy": {
            "const": "fixed"
          },
          "expected": {
            "type": "object",
            "required": [
              "not_an_execution_result"
            ],
            "properties": {
              "not_an_execution_result": {
                "const": true
              }
            }
          },
          "execution_status_by_method": {
            "type": "object",
            "required": [
              "static",
              "rendered",
              "interaction",
              "native-application",
              "native-proofreading"
            ],
            "properties": {
              "static": {
                "const": "not-checked"
              },
              "rendered": {
                "const": "not-checked"
              },
              "interaction": {
                "const": "not-checked"
              },
              "native-application": {
                "const": "not-checked"
              },
              "native-proofreading": {
                "const": "not-checked"
              }
            },
            "additionalProperties": false
          },
          "status": {
            "const": "not-checked"
          },
          "result": {
            "type": "null"
          },
          "execution_evidence": {
            "type": "array",
            "maxItems": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
