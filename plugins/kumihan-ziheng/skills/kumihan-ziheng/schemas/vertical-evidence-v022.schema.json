{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ziheng 0.2.2 vertical evidence sidecar",
  "description": "Structural declarations only. scripts/evidence.py validate_vertical_evidence enforces method/scope obligations; neither validates evidence truth or executes a test. One record per artifact, variant, scope and method.",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "variant_id",
    "artifact",
    "full_input_bundle_sha256",
    "method",
    "scope",
    "status",
    "evidence_refs",
    "limitations",
    "observation",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.2"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^V-(TW|HK|SH)[0-9]{2}$"
    },
    "variant_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "full_input_bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "enum": [
        "static",
        "rendered",
        "interaction",
        "native-application",
        "native-proofreading"
      ]
    },
    "scope": {
      "enum": [
        "source-preservation",
        "fixture-integrity",
        "font-coverage",
        "font-metrics",
        "font-features",
        "logical-text-order",
        "pdf-extraction",
        "pdf-structure",
        "vertical-glyph",
        "regional-glyph",
        "punctuation-placement",
        "run-orientation",
        "column-layout",
        "line-breaking",
        "text-decoration",
        "ruby-bopomofo",
        "reflow",
        "pdf-appearance",
        "copy-search",
        "focus-order",
        "assistive-technology",
        "writing-mode-switch",
        "native-reopen",
        "native-export",
        "native-proofreading"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "needs-review",
        "not-checked",
        "unsupported",
        "not-applicable",
        "waived"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "artifact_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "observation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "object",
      "required": [
        "id",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "editorial_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object"
    },
    "layout": {
      "type": "object"
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shaping": {
      "type": "object"
    },
    "reflow": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "waiver": {
      "type": "object",
      "required": [
        "approval_ref",
        "artifact_sha256"
      ],
      "properties": {
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
