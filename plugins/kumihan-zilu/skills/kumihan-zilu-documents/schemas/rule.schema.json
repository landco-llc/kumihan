{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rule",
  "type": "object",
  "required": [
    "id",
    "status",
    "source_ids",
    "sections",
    "autofix_allowed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^KH-CN-R[0-9]{3}$"
    },
    "status": {
      "enum": [
        "implemented",
        "advisory-only",
        "deferred"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "object"
    },
    "autofix_allowed": {
      "const": false
    }
  }
}
