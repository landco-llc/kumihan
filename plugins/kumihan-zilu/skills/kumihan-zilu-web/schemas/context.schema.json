{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context",
  "type": "object",
  "required": [
    "mode",
    "locale",
    "medium",
    "protected_text"
  ],
  "properties": {
    "mode": {
      "enum": [
        "study",
        "build",
        "audit",
        "refine"
      ]
    },
    "locale": {
      "type": "string"
    },
    "medium": {
      "type": "string"
    },
    "protected_text": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "enum": [
        "cn-vertical-reading",
        "cn-vertical-display",
        "cn-vertical-publication-gb",
        "cn-classical-reference"
      ]
    },
    "writing_mode": {
      "enum": [
        "horizontal-tb",
        "vertical-rl",
        "vertical-lr",
        "unspecified"
      ]
    },
    "direction_reason": {
      "type": "string"
    },
    "selected_standards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "css": {
      "type": "string"
    },
    "per_character_breaks": {
      "type": "boolean"
    }
  }
}
