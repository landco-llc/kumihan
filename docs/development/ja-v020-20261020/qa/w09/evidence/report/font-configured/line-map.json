        "bbox": [
          63.0,
          372.9861755371094,
          206.9774169921875,
          388.6157531738281
        ]
      },
      {
        "text": "日時と場所、料金と宛名、操作の目的の順に確認します。案内文を読み終える前に別の場所を",
        "bbox": [
          63.0,
          411.82440185546875,
          523.3601684570312,
          422.6105041503906
        ]
      },
      {
        "text": "探さなくて済むよう、必須情報を同じページにまとめます。",
        "bbox": [
          63.0,
          430.57440185546875,
          358.4354248046875,
          441.3605041503906
        ]
      },
      {
        "text": "注記：会場と講座は架空です。この資料は実際の予約や支払を受け付けません。",
        "bbox": [
          74.25,
          460.10699462890625,
          397.3499755859375,
          468.90899658203125
        ]
      }
